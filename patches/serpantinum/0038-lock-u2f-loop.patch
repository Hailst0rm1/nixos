--- a/src/quickshell/lock/Lock.qml
+++ b/src/quickshell/lock/Lock.qml
@@ -16,6 +16,12 @@ Scope {
     property int resumeRevision: 0
 
     property int connectedScreenCount: 1
+    // pam_u2f's cue message is only set while the key is flashing for a touch.
+    // The text is latched so it fades out with the pill instead of vanishing
+    // the moment the check ends.
+    property bool u2fShown: false
+    property string u2fText: ""
+    property double u2fCueSince: 0
     property bool fingerprintAvailable: false
     property bool fpUnsupported: false
     property bool fpHolding: false
@@ -124,21 +130,21 @@ Scope {
         command: [
             "bash",
             "-c",
-            "test -e \"${1:-/etc/pam.d}/serpantinum\"",
+            "test -e \"${1:-/etc/pam.d}/serpantinum-password\"",
             "pam-probe",
             pam.configDirectory
         ]
         onExited: (exitCode) => {
             if (exitCode !== 0) return;
-            pam.config = "serpantinum";
-            fpPam.config = "serpantinum";
-            root.defaultPamConfig = "serpantinum";
+            pam.config = "serpantinum-password";
+            fpPam.config = "serpantinum-password";
+            root.defaultPamConfig = "serpantinum-password";
         }
     }
 
     Process {
         id: noFpPamBuilder
-        command: ["bash", Caching.serpantinumDir + "/scripts/system/pam_without_fingerprint.sh", root.defaultPamDir, root.noFpPamDir, "serpantinum"]
+        command: ["bash", Caching.serpantinumDir + "/scripts/system/pam_without_fingerprint.sh", root.defaultPamDir, root.noFpPamDir, "serpantinum-password"]
         onExited: (exitCode) => root.noFpPamReady = exitCode === 0
     }
 
@@ -243,6 +249,7 @@ Scope {
 
     function beginAuth() {
         if (!rootLock.locked || root.isUnlocking) return;
+        if (!u2fPam.active) u2fPam.start();
         root.startFingerprint();
         passwordStartTimer.restart();
     }
@@ -252,6 +259,8 @@ Scope {
         fingerprintSettleTimer.stop();
         passwordStartTimer.stop();
         passwordRetryTimer.stop();
+        u2fRetryTimer.stop();
+        if (u2fPam.active) u2fPam.abort();
         root.fpAborting = true;
         root.fpHolding = false;
         if (fpPam.active) fpPam.abort();
@@ -382,6 +391,7 @@ Scope {
         root.fpUnsupported = false;
         root.fingerprintAvailable = false;
         fingerprintUnlockTimer.stop();
+        root.u2fShown = false;
         rootLock.locked = true;
         pamActionTimer.start();
     }
@@ -455,6 +465,54 @@ Scope {
         onError: root.markFingerprintUnsupported()
     }
 
+    // The YubiKey gives up on a touch after ~30s, so the key check runs as its
+    // own PAM stack and restarts whenever it lapses, independent of the
+    // password prompt. Without a key plugged in it fails at once and polls.
+    Timer {
+        id: u2fRetryTimer
+        interval: 1000
+        onTriggered: {
+            if (rootLock.locked && !root.isUnlocking && !u2fPam.active) u2fPam.start();
+        }
+    }
+
+    Timer {
+        id: u2fHideTimer
+        interval: 2000
+        onTriggered: root.u2fShown = false
+    }
+
+    PamContext {
+        id: u2fPam
+        config: "serpantinum-u2f"
+
+        onMessageChanged: {
+            if (message === "") return;
+            u2fHideTimer.stop();
+            root.u2fText = message;
+            root.u2fCueSince = Date.now();
+            root.u2fShown = true;
+        }
+
+        // On success the cue stays up and fades with the lock screen. On the
+        // key's ~30s touch timeout it is held across the retry gap so it does
+        // not blink; any earlier failure (key pulled) hides it at once.
+        // shortcut: elapsed-time heuristic, assumes the key times out after >25s.
+        onCompleted: (result) => {
+            if (result === PamResult.Success) {
+                root.finishUnlock();
+                return;
+            }
+            if (Date.now() - root.u2fCueSince > 25000) u2fHideTimer.restart();
+            else root.u2fShown = false;
+            if (rootLock.locked && !root.isUnlocking) u2fRetryTimer.restart();
+        }
+        onError: {
+            root.u2fShown = false;
+            if (rootLock.locked && !root.isUnlocking) u2fRetryTimer.restart();
+        }
+    }
+
     PamContext {
         id: pam
 
diff --git a/src/quickshell/lock/LockScreen.qml b/src/quickshell/lock/LockScreen.qml
index bed53a7..4dae0ca 100644
--- a/src/quickshell/lock/LockScreen.qml
+++ b/src/quickshell/lock/LockScreen.qml
@@ -24,6 +24,77 @@ FocusScope {
     anchors.fill: parent
     focus: true
 
+    // "Touch your key" pill, shown while pam_u2f waits on the YubiKey.
+    component U2fCue: Rectangle {
+        id: cue
+        property real px: 1
+        property string text: ""
+        property bool shown: false
+
+        implicitWidth: cueRow.implicitWidth + 28 * px
+        implicitHeight: 34 * px
+        width: implicitWidth
+        height: implicitHeight
+        radius: height / 2
+        color: Qt.rgba(0, 0, 0, 0.28)
+        border.width: Math.max(1, px)
+        border.color: Qt.rgba(ThemeBackend.mauve.r, ThemeBackend.mauve.g, ThemeBackend.mauve.b, 0.35 + 0.45 * cue.pulse)
+        opacity: cue.shown ? 1 : 0
+        visible: opacity > 0
+        Behavior on opacity { NumberAnimation { duration: 250; easing.type: Easing.OutCubic } }
+
+        // One phase drives glyph, ring and border so they flash together,
+        // roughly in step with the YubiKey's own LED.
+        property real pulse: 0
+        SequentialAnimation on pulse {
+            running: cue.shown
+            loops: Animation.Infinite
+            NumberAnimation { to: 1; duration: 450; easing.type: Easing.OutCubic }
+            NumberAnimation { to: 0; duration: 650; easing.type: Easing.InCubic }
+        }
+
+        Row {
+            id: cueRow
+            anchors.centerIn: parent
+            spacing: 10 * cue.px
+
+            Item {
+                width: 18 * cue.px
+                height: 18 * cue.px
+                anchors.verticalCenter: parent.verticalCenter
+
+                Rectangle {
+                    anchors.centerIn: parent
+                    width: parent.width * (1 + 0.9 * cue.pulse)
+                    height: width
+                    radius: width / 2
+                    color: "transparent"
+                    border.width: Math.max(1, 1.5 * cue.px)
+                    border.color: ThemeBackend.mauve
+                    opacity: 0.6 * (1 - cue.pulse)
+                }
+
+                Text {
+                    anchors.centerIn: parent
+                    text: "󰌆"
+                    font.family: ThemeBackend.iconFont
+                    font.pixelSize: 16 * cue.px
+                    color: ThemeBackend.mauve
+                    opacity: 0.45 + 0.55 * cue.pulse
+                }
+            }
+
+            Text {
+                anchors.verticalCenter: parent.verticalCenter
+                text: cue.text
+                font.family: ThemeBackend.fontFamily
+                font.pixelSize: 13 * cue.px
+                font.weight: Font.Bold
+                color: "#ffffff"
+            }
+        }
+    }
+
     Rectangle {
         anchors.fill: parent
         color: ThemeBackend.crust
@@ -638,6 +709,15 @@ FocusScope {
             LockPowerControls {
                 screenRoot: lockScreenRoot
             }
+
+            U2fCue {
+                anchors.horizontalCenter: parent.horizontalCenter
+                anchors.bottom: parent.bottom
+                anchors.bottomMargin: lockScreenRoot.s(140)
+                px: lockScreenRoot.s(1)
+                text: root.u2fText
+                shown: root.u2fShown
+            }
     }
     }
 }
