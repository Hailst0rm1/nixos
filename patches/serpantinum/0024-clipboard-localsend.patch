+        if (clipboardWindow.lsPayloadFile !== "") {
+            argv.push("--file", clipboardWindow.lsPayloadFile);
+        } else {
+            argv.push("--text", clipboardWindow.lsPayloadText);
+        }
+        clipboardWindow.lsPhase = "busy";
+        clipboardWindow.lsMessage = "sending";
