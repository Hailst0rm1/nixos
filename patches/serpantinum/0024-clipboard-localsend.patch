+        clipboardWindow.lsPhase = "discovering";
+        clipboardWindow.lsMessage = "looking for devices";
+        lsDiscover.running = false;
+        lsDiscover.running = true;
+    }
+
+    Process {
+        id: lsDiscover
+        running: false
+        command: ["python3", clipboardWindow.lsScript, "discover", "--timeout", "5"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                let raw = this.text ? this.text.trim() : "";
+                let peers = [];
+                if (raw !== "") {
+                    try {
+                        let d = JSON.parse(raw.split("\n").pop());
+                        peers = d.peers || [];
+                    } catch (e) {
+                        peers = [];
+                    }
+                }
+                lsPeerModel.clear();
+                for (let i = 0; i < peers.length; i++) lsPeerModel.append(peers[i]);
+                if (peers.length === 0) {
+                    clipboardWindow.lsPhase = "error";
+                    clipboardWindow.lsMessage = "no devices found — open LocalSend on your phone";
+                } else {
