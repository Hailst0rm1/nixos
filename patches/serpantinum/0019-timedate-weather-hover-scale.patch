diff --git a/src/quickshell/bar/BarModule.qml b/src/quickshell/bar/BarModule.qml
index e91867e..f9597bd 100644
--- a/src/quickshell/bar/BarModule.qml
+++ b/src/quickshell/bar/BarModule.qml
@@ -92,8 +92,21 @@ Rectangle {
         NumberAnimation { duration: 250; easing.type: Easing.OutCubic }
     }
 
+    // The clock and the weather form one group box that toggles one popup, so
+    // the box behaves as a single button: hovering either half lights and pops
+    // both. Only faces exposing selfHovered take part. groupHovered is driven
+    // from TopBar.qml, which reads selfHovered rather than isHovered — binding
+    // the two modules' isHovered to each other would be a loop.
+    readonly property bool selfHovered: !!(faceLoader.item && faceLoader.item.selfHovered)
+    property bool groupHovered: false
+    readonly property bool isHovered: selfHovered || groupHovered
+
+    scale: isHovered ? 1.03 : 1.0
+    Behavior on scale { NumberAnimation { duration: 250; easing.type: Easing.OutQuint } }
+
     radius: ThemeBackend.borderRadius
-    color: isGrouped || pillGlass.active ? "transparent" : (isSolid ? (distinctPills ? Qt.alpha(Qt.darker(ThemeBackend.surface0, 1.15), root.barOpacity) : "transparent") : Qt.alpha(ThemeBackend.base, root.barOpacity))
+    color: isGrouped || pillGlass.active ? "transparent" : (isSolid ? (distinctPills ? Qt.alpha(isHovered ? ThemeBackend.surface0 : Qt.darker(ThemeBackend.surface0, 1.15), root.barOpacity) : "transparent") : Qt.alpha(isHovered ? ThemeBackend.surface0 : ThemeBackend.base, root.barOpacity))
+    Behavior on color { ColorAnimation { duration: 250 } }
     clip: true
 
     WallpaperBlur {
